<?xml version="1.0" encoding="utf-8" ?>
<?xml-comp compile="true" ?>
<ResourceDictionary
    x:Class="MAUI_Test_App.Resources.Styles.ClassResourceDictionary"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <DataTemplate x:Key="ClothResource">
        <Grid
            Margin="10,10,10,0"
            ColumnDefinitions=".1*,.2*,.7*"
            RowDefinitions="*,*">
            <Frame
                Grid.RowSpan="2"
                Grid.Column="1"
                Grid.ColumnSpan="2">
                <Grid>
                    <Image
                        Grid.RowSpan="2"
                        Grid.ColumnSpan="2"
                        Source="{Binding Image}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        Text="{Binding Title}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="2"
                        Text="{Binding Price, StringFormat='{0:C}'}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>
        </Grid>
    </DataTemplate>
</ResourceDictionary>