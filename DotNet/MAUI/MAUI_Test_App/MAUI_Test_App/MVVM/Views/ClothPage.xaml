<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MAUI_Test_App.MVVM.Views.ClothPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Selectors="clr-namespace:MAUI_Test_App.Selectors"
    Title="ClothPage">
    <ContentPage.Resources>
        <Selectors:ClothDataTemplateSelector x:Key="ClothResource" />
    </ContentPage.Resources>
    <CollectionView ItemTemplate="{StaticResource ClothResource}" ItemsSource="{Binding Products}" />
</ContentPage>