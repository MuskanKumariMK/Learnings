<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MAUI_Test_App.MVVM.Views.ClothPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ClothPage">
    <CollectionView ItemsSource="{Binding Products}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid
                    Margin="10,10,10,0"
                    ColumnDefinitions=".1*,.2*,.7*"
                    RowDefinitions="*,*">
                    <Frame
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        CornerRadius="10"
                        HasShadow="True"
                        HeightRequest="100"
                        WidthRequest="100">
                        <Grid>
                            <Image
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="2"
                                HeightRequest="100"
                                Source="{Binding Image}" />
                            <Label
                                Grid.Column="2"
                                Text="{Binding Title}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="{Binding Price, StringFormat='{0:C}'}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>